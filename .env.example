# Environment Configuration Template
#
# Copy the variables required by the chosen stack or integrations into this
# file during project initialization. Keep sample values sanitized and never
# commit real credentials, tokens, private keys, or production endpoints.

# Application
# APP_ENV=development
# APP_PORT=3000

# External services
# EXTERNAL_API_BASE_URL=https://api.example.com
# EXTERNAL_API_TOKEN=replace-with-local-secret

# Data storage
# DATABASE_URL=replace-with-local-connection-string
